# ─── Shopify Storefront API ────────────────────────────────────────
# Copier ce fichier vers `.env.local` puis remplir avec les vraies
# valeurs (cf. README pour la procédure complète d'obtention du token).
# Sans ces deux variables, le front fait fallback sur `mockProducts`.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
